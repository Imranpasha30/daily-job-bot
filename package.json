{
  "name": "daily-job-bot",
  "version": "1.0.0",
  "description": "Daily automated job fetcher and AI application agent for Backend and Cybersecurity roles",
  "main": "source/refresh_all.js",
  "scripts": {
    "start": "node source/refresh_all.js && node source/email_digest.js",
    "refresh": "node source/refresh_all.js",
    "email": "node source/email_digest.js",
    "apply": "node agent/apply_agent.js --mode safe",
    "apply:auto": "node agent/apply_agent.js --mode auto",
    "apply:backend": "node agent/apply_agent.js --category backend --mode auto",
    "apply:cyber": "node agent/apply_agent.js --category cyber --mode auto",
    "apply:dry": "node agent/apply_agent.js --dry-run",
    "apply:stats": "node agent/apply_agent.js --stats"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "nodemailer": "^6.9.16",
    "playwright": "^1.64.1"
  }
}
